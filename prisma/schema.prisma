generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AdminRole {
  SUPER_ADMIN
  CONTENT_ADMIN
}

enum PublicationStatus {
  DRAFT
  PUBLISHED
  UNPUBLISHED
}

enum NoticeType {
  NEWS
  NOTICE
}

enum EventStatus {
  UPCOMING
  PAST
}

enum EnquiryStatus {
  NEW
  CONTACTED
  IN_PROGRESS
  CLOSED
}

enum CalendarCategory {
  SCHOOL_EVENT
  HOLIDAY
  EXAMINATION
  PTM
  ADMISSION
  ACTIVITY
  OTHER
}

enum AcademicEntryType {
  SESSION
  TERM
  PTM
  EXAMINATION
  HOLIDAY
}

enum FacultyCategory {
  TEACHING_FACULTY
  ACADEMIC_COORDINATOR
  ADMINISTRATIVE_STAFF
  SUPPORT_STAFF
}

model AdminUser {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         AdminRole @default(CONTENT_ADMIN)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Notice {
  id          String            @id @default(cuid())
  type        NoticeType        @default(NOTICE)
  title       String
  slug        String            @unique
  description String?
  content     String?
  category    String
  imageUrl    String?
  imageKey    String?
  imageAlt    String?
  documentUrl String?
  status      PublicationStatus @default(DRAFT)
  isPinned    Boolean           @default(false)
  isArchived  Boolean           @default(false)
  publishDate DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([status, publishDate])
  @@index([type, status, publishDate])
  @@index([category, status])
  @@index([isPinned, status])
  @@index([isArchived, publishDate])
}

model Event {
  id            String            @id @default(cuid())
  title         String
  slug          String            @unique
  description   String?
  eventDate     DateTime?
  eventTime     String?
  venue         String?
  imageUrl      String?
  imageKey      String?
  imageAlt      String?
  category      String
  status        EventStatus       @default(UPCOMING)
  isFeatured    Boolean           @default(false)
  publication   PublicationStatus @default(DRAFT)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  galleryAlbums GalleryAlbum[]

  @@index([status, eventDate])
  @@index([category, status])
  @@index([isFeatured, publication])
  @@index([publication, eventDate])
}

model Achievement {
  id                String            @id @default(cuid())
  title             String
  category          String
  studentName       String?
  year              Int?
  achievementDate   DateTime?
  description       String?
  imageUrl          String?
  imageKey          String?
  imageAlt          String?
  status            PublicationStatus @default(DRAFT)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([status, achievementDate])
  @@index([category, status])
  @@index([year, status])
}

model GalleryAlbum {
  id          String        @id @default(cuid())
  title       String
  slug        String        @unique
  category    String
  description String?
  albumDate   DateTime?
  coverImage  String?
  coverImageKey String?
  coverImageAlt String?
  status      PublicationStatus @default(DRAFT)
  eventId     String?
  event       Event?        @relation(fields: [eventId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  photos      GalleryPhoto[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([category, status])
  @@index([eventId])
  @@index([status, albumDate])
}

model GalleryPhoto {
  id        String       @id @default(cuid())
  albumId   String
  album     GalleryAlbum @relation(fields: [albumId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  imageUrl  String?
  imageKey  String?
  altText   String?
  caption   String?
  sortOrder Int          @default(0)
  status    PublicationStatus @default(DRAFT)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([albumId, status, sortOrder])
}

model Enquiry {
  id                String        @id @default(cuid())
  applicantName     String
  studentName       String?
  phone             String
  email             String?
  classApplyingFor  String?
  enquiryType       String?
  message           String
  status            EnquiryStatus  @default(NEW)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([status, createdAt])
  @@index([email])
  @@index([phone])
}

model Download {
  id          String            @id @default(cuid())
  title       String
  description String?
  category    String
  fileUrl     String
  fileName    String?
  fileType    String?
  fileSize    String?
  status      PublicationStatus @default(DRAFT)
  publishDate DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([category, status])
  @@index([status, publishDate])
}

model SchoolSetting {
  id           String   @id @default("school")
  schoolName   String?
  schoolHistory String?
  vision       String?
  mission      String?
  motto        String?
  mottoSupportText String?
  aboutSchool  String?
  principalMessage String?
  chairmanDirectorMessage String?
  principalName        String?
  principalDesignation String?
  principalPhotoUrl    String?
  principalPhotoKey    String?
  principalPhotoAlt    String?
  heroImageUrl         String?
  heroImageKey         String?
  heroImageAlt         String?
  introImageUrl        String?
  introImageKey        String?
  introImageAlt        String?
  galleryImageOneUrl   String?
  galleryImageOneKey   String?
  galleryImageOneAlt   String?
  galleryImageTwoUrl   String?
  galleryImageTwoKey   String?
  galleryImageTwoAlt   String?
  galleryImageThreeUrl String?
  galleryImageThreeKey String?
  galleryImageThreeAlt String?
  galleryImageFourUrl  String?
  galleryImageFourKey  String?
  galleryImageFourAlt  String?
  galleryImageFiveUrl  String?
  galleryImageFiveKey  String?
  galleryImageFiveAlt  String?
  principalDeskTitle   String?
  sportsMessage           String?
  sportsMessageAuthorName String?
  sportsMessageAuthorRole String?
  footerText   String?
  address      String?
  phone        String?
  email        String?
  websiteUrl   String?
  instagramUrl String?
  facebookUrl  String?
  youtubeUrl   String?
  whatsappNumber String?
  mapLink      String?
  mapLatitude  Decimal? @db.Decimal(10, 7)
  mapLongitude Decimal? @db.Decimal(10, 7)
  workingHours Json?
  socialLinks  Json?
  extraSettings Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model SchoolCalendarItem {
  id          String            @id @default(cuid())
  title       String
  startDate   DateTime
  endDate     DateTime?
  eventTime   String?
  category    CalendarCategory  @default(OTHER)
  description String?
  venue       String?
  isImportant Boolean           @default(false)
  status      PublicationStatus @default(DRAFT)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([startDate, status])
  @@index([category, status])
  @@index([isImportant, status])
}

model AdmissionSetting {
  id                    String   @id @default("admissions")
  headline              String?
  introduction          String?
  startDate             DateTime?
  endDate               DateTime?
  availableClasses      Json?
  eligibility           String?
  requiredDocuments     Json?
  admissionProcess      Json?
  importantInstructions Json?
  feeInformation        String?
  contactInformation    String?
  formTitle             String?
  formDescription       String?
  formUrl               String?
  isPublished           Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model Subject {
  id          String            @id @default(cuid())
  name        String
  shortName   String?
  className   String?
  department  String?
  description String?
  sortOrder   Int               @default(0)
  status      PublicationStatus @default(DRAFT)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([className, status])
  @@index([department, status])
  @@index([status, sortOrder])
}

model AcademicCalendarEntry {
  id          String            @id @default(cuid())
  entryType   AcademicEntryType
  title       String
  sessionName String?
  startDate   DateTime?
  endDate     DateTime?
  classes     String?
  description String?
  sortOrder   Int               @default(0)
  status      PublicationStatus @default(DRAFT)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([entryType, status])
  @@index([sessionName, status])
  @@index([status, sortOrder])
}

model CoCurricularActivity {
  id           String            @id @default(cuid())
  name         String
  category     String
  description  String?
  imageUrl     String?
  ageGroup     String?
  sortOrder    Int               @default(0)
  status       PublicationStatus @default(DRAFT)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([category, status])
  @@index([status, sortOrder])
}

model Sport {
  id           String            @id @default(cuid())
  name         String
  category     String
  description  String?
  imageUrl     String?
  ageGroup     String?
  sortOrder    Int               @default(0)
  status       PublicationStatus @default(DRAFT)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([category, status])
  @@index([status, sortOrder])
}

model FacultyMember {
  id           String            @id @default(cuid())
  fullName     String
  designation  String
  department   String?
  subject      String?
  category     FacultyCategory
  qualification String?
  photoUrl     String?
  photoKey     String?
  photoAlt     String?
  biography    String?
  sortOrder    Int               @default(0)
  status       PublicationStatus @default(DRAFT)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([category, status])
  @@index([status, sortOrder])
}

model Facility {
  id          String            @id @default(cuid())
  name        String
  category    String
  description String?
  imageUrl    String?
  imageKey    String?
  imageAlt    String?
  sortOrder   Int               @default(0)
  status      PublicationStatus @default(DRAFT)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([category, status])
  @@index([status, sortOrder])
}
