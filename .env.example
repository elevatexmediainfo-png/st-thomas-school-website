# Copy to .env.local for local development or configure in your production secret manager.
DATABASE_URL=
AUTH_SECRET=
AUTH_TRUST_HOST=

# Used only by `npm run admin:create` for the first real school administrator.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_ROLE=

# Optional media provider. Leave blank until a provider adapter is configured.
MEDIA_STORAGE_PROVIDER=
MEDIA_STORAGE_BUCKET=
MEDIA_STORAGE_REGION=
MEDIA_STORAGE_ENDPOINT=
MEDIA_STORAGE_ACCESS_KEY_ID=
MEDIA_STORAGE_SECRET_ACCESS_KEY=
MEDIA_STORAGE_PUBLIC_BASE_URL=
